# ============================================================
# B-Attend — Production / Vercel environment
# Copy values into the deployment provider's encrypted environment settings.
# NEVER commit real secrets.
# ============================================================

# --- Database (managed PostgreSQL only) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/battend?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/battend?sslmode=require"
DB_CONNECTION_LIMIT="10"
DB_POOL_TIMEOUT_SEC="10"
# Enable only when this deployment is the controlled migration owner.
# Otherwise run `prisma migrate deploy` in a dedicated release step first.
RUN_PRISMA_MIGRATIONS="false"

# --- App ---
APP_URL="https://app.example.com"
NODE_ENV="production"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Session signing ---
# Generate a strong random value of at least 32 bytes.
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# --- Distributed abuse protection ---
# Required in production so all serverless instances share auth/API counters.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_TOKEN"

# --- Transactional email ---
# Invitations never contain a temporary password. They contain a one-time,
# hashed-at-rest invitation token. Resend is the current production adapter.
EMAIL_PROVIDER="resend"
EMAIL_FROM="B-Attend <no-reply@example.com>"
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

# --- Billing ---
# sales_assisted: B-Attend/admin team provisions/collects payment and activates.
# self_service: customer can pay online; requires a real provider + signed webhook.
BILLING_MODE="sales_assisted"
PAYMENT_PROVIDER="manual"
PAYMENT_WEBHOOK_SECRET=""

# Paymob placeholders for the self-service phase. Do not set fake values.
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""

# --- Attendance verification / anti-fraud ---
# Safe default. `none` means no server-verifiable device/biometric provider is
# connected. Tenant settings are fail-closed and cannot require capabilities a
# configured provider does not advertise. Never replace this with a made-up key.
ATTENDANCE_VERIFICATION_PROVIDER="none"
# Real provider-specific credentials belong in encrypted deployment secrets and
# are added only with the corresponding server-side adapter. Raw biometric media
# must not be persisted by B-Attend's attendance trust records.

# --- AI / B-Coach ---
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AI_DAILY_COACH_ENABLED="true"
AI_EMPLOYEE_INSIGHTS_ENABLED="true"
AI_MANAGER_INSIGHTS_ENABLED="true"

# --- Platform bootstrap ---
# Prefer a one-time controlled bootstrap procedure; never keep a demo password.
SUPER_ADMIN_EMAIL="super@example.com"
SUPER_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ONE_TIME_BOOTSTRAP_PASSWORD"

# --- Demo seeding safety latch ---
DEMO_SEED_CONFIRM="false"
