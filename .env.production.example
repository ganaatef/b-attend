# ============================================================
# B-Attend — Production / Vercel environment
# Copy values into the deployment provider's encrypted environment settings.
# NEVER commit real secrets.
# ============================================================

# --- Database (managed PostgreSQL only) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/battend?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/battend?sslmode=require"
DB_CONNECTION_LIMIT="10"
DB_POOL_TIMEOUT_SEC="10"
# Enable only when this deployment is the controlled migration owner.
# Otherwise run `prisma migrate deploy` in a dedicated release step first.
RUN_PRISMA_MIGRATIONS="false"

# --- App ---
APP_URL="https://app.example.com"
NODE_ENV="production"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Session signing ---
# Generate a strong random value of at least 32 bytes.
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# --- Distributed abuse protection ---
# Required in production so all serverless instances share auth/API counters.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_TOKEN"

# --- Transactional email ---
EMAIL_PROVIDER="resend"
EMAIL_FROM="B-Attend <no-reply@example.com>"
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

# --- Billing ---
BILLING_MODE="sales_assisted"
PAYMENT_PROVIDER="manual"
PAYMENT_WEBHOOK_SECRET=""
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_HMAC_SECRET=""

# --- Attendance verification / anti-fraud ---
# Device attestation and biometric identity are intentionally separate adapters.
# Keep both `none` until the corresponding native client + encrypted production
# credentials have been configured and release-tested.
ATTENDANCE_VERIFICATION_PROVIDER="none"
ATTENDANCE_BIOMETRIC_PROVIDER="none"

# Android device-integrity option: `google_play_integrity`.
GOOGLE_PLAY_INTEGRITY_PACKAGE_NAME="com.example.battend.staff"
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_INTEGRITY_CERT_SHA256=""
GOOGLE_PLAY_INTEGRITY_REQUIRE_LICENSED="true"
GOOGLE_PLAY_INTEGRITY_REQUIRE_STRONG="false"
GOOGLE_PLAY_INTEGRITY_MAX_TOKEN_AGE_MS="600000"

# Face + liveness option: set ATTENDANCE_BIOMETRIC_PROVIDER=`aws_rekognition`.
# Use a dedicated least-privilege IAM principal/role. Never expose these values
# to the employee app. The native app receives only provider session/region data
# needed for the Face Liveness capture flow.
AWS_REKOGNITION_REGION="me-south-1"
AWS_REKOGNITION_ACCESS_KEY_ID=""
AWS_REKOGNITION_SECRET_ACCESS_KEY=""
AWS_REKOGNITION_SESSION_TOKEN=""
AWS_REKOGNITION_COLLECTION_ID="b-attend-production"
# Optional customer-managed KMS key for liveness session output.
AWS_REKOGNITION_KMS_KEY_ID=""
# Server-side thresholds, 0–100. Duplicate threshold must be >= match threshold.
AWS_REKOGNITION_LIVENESS_THRESHOLD="90"
AWS_REKOGNITION_FACE_MATCH_THRESHOLD="90"
AWS_REKOGNITION_DUPLICATE_THRESHOLD="97"

# Raw device-integrity tokens, selfie video, liveness reference images and camera
# media must never be persisted in B-Attend operational/audit data. Store only
# normalized verdicts and opaque provider references.

# --- AI / B-Coach ---
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AI_DAILY_COACH_ENABLED="true"
AI_EMPLOYEE_INSIGHTS_ENABLED="true"
AI_MANAGER_INSIGHTS_ENABLED="true"

# --- Platform bootstrap ---
SUPER_ADMIN_EMAIL="super@example.com"
SUPER_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ONE_TIME_BOOTSTRAP_PASSWORD"

# --- Demo seeding safety latch ---
DEMO_SEED_CONFIRM="false"
