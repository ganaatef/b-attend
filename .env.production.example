# ============================================================
# B-Attend — Production / Vercel environment (.env.production.example)
# Copy values into Vercel Project Settings → Environment Variables.
# DO NOT commit real secrets. Use Vercel's encrypted env storage.
# Production database MUST be PostgreSQL (Neon / Supabase / Vercel Postgres).
# ============================================================

# --- Database (PostgreSQL — NOT SQLite) ---
# Example (Neon): postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/battend?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/battend?sslmode=require"
# Required by some providers (Supabase) for `prisma migrate deploy`. Usually same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/battend?sslmode=require"

# --- App ---
APP_URL="https://your-app.vercel.app"
NODE_ENV="production"

# --- Session (REQUIRED — generate a strong secret) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_NODE_CRYPTO"

# --- Super Admin bootstrap (used by demo seed) ---
SUPER_ADMIN_EMAIL="super@b-attend.app"
SUPER_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# --- AI / B-Coach (mock provider is safe for the client demo; no key needed) ---
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AI_DAILY_COACH_ENABLED="true"
AI_EMPLOYEE_INSIGHTS_ENABLED="true"
AI_MANAGER_INSIGHTS_ENABLED="true"

# --- Activation & payments (manual mode for demo) ---
MANUAL_ACTIVATION_MODE="true"
PAYMENT_PROVIDER="manual"

# --- Email / SMTP (optional; leave blank to disable outbound email) ---
EMAIL_FROM="no-reply@b-attend.app"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Demo seeding ---
# Set to "true" ONLY when you intentionally run `npm run db:seed:demo` against
# the live demo database. Never set this by default in production.
DEMO_SEED_CONFIRM="false"
