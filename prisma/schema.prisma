  leaveType     LeaveType          @relation(fields: [leaveTypeId], references: [companyId], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  daysCount     Int
  reason        String?
  status        LeaveRequestStatus @default(PENDING)
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  rejectedById  String?
  rejectedAt    DateTime?
  managerNotes  String?
  attachmentUrl String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([leaveTypeId])
}

// ── Employee Warning ──
