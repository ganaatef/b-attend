// ── Job Title ──
model JobTitle {
  id            String   @id @default(cuid())
  companyId     String
  tenant        Tenant   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  description   String?
  grade         String?
  active        Boolean  @default(true)
  employees     Employee[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, title])
  @@index([companyId])
  @@index([departmentId])
}

// ── Employee Contract ──
model EmployeeContract {
  id                String         @id @default(cuid())
  companyId         String
  tenant            Tenant         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractNumber    String
  contractType      ContractType   @default(FULL_TIME)
  startDate         DateTime
  endDate           DateTime?
  probationEndDate DateTime?
  status            ContractStatus @default(DRAFT)
  salaryReference   Int?
  fileUrl           String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([endDate])
}

// ── Employee Document ──
model EmployeeDocument {
  id            String          @id @default(cuid())
  companyId     String
  tenant        Tenant          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  documentNumber String?
  issueDate     DateTime?
  expiryDate    DateTime?
  status        DocumentStatus  @default(MISSING)
  fileUrl       String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([documentType])
  @@index([status])
  @@index([expiryDate])
}

// ── Leave Type ──
model LeaveType {
  companyId             String  @id
  tenant                Tenant  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  paid                  Boolean @default(true)
  requiresApproval      Boolean @default(true)
  annualAllowanceDays   Int     @default(0)
  carryForwardAllowed   Boolean @default(false)
  active                Boolean @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  balances              LeaveBalance[]
  requests              LeaveRequest[]

  @@index([companyId])
  @@index([active])
}

// ── Leave Policy ──
model LeavePolicy {
  id                              String   @id @default(cuid())
  companyId                       String
  tenant                          Tenant   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                            String
  description                     String?
  defaultAnnualDays               Int      @default(21)
  allowNegativeBalance            Boolean  @default(false)
  requiresAttachmentForSickLeave  Boolean  @default(true)
  active                          Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@index([companyId])
}

// ── Leave Balance ──
model LeaveBalance {
  id              String   @id @default(cuid())
  companyId       String
  tenant          Tenant   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [companyId], onDelete: Cascade)
  year            Int
  openingBalance  Int       @default(0)
  accrued         Int       @default(0)
  used            Int       @default(0)
  pending         Int       @default(0)
  remaining       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, employeeId, leaveTypeId, year])
  @@index([companyId, employeeId])
  @@index([year])
}

// ── Leave Request ──
model LeaveRequest {
  id            String             @id @default(cuid())
  companyId     String
  tenant        Tenant             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
