# B-Attend SaaS — Phase 1 environment
# Database (SQLite fallback for local dev — production should use PostgreSQL)
DATABASE_URL="file:./dev.db"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session
SESSION_SECRET="dev-secret-change-me-in-production-please-use-32+chars"

# Email (placeholders — Phase 1 does not send real email)
EMAIL_FROM="no-reply@b-attend.app"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Payment (placeholders — Phase 1 uses MANUAL activation only)
PAYMENT_PROVIDER="MANUAL"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Activation mode
MANUAL_ACTIVATION_MODE="true"

# Super Admin bootstrap (used by seed)
SUPER_ADMIN_EMAIL="super@b-attend.app"
SUPER_ADMIN_PASSWORD="demo1234"
