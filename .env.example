# ============================================================
# B-Attend — Local development environment (.env.example)
# Copy to `.env` for local development. SQLite is allowed locally.
# DO NOT commit real secrets. DO NOT use SQLite in production.
# ============================================================

# --- Database (PostgreSQL — required for both local dev and production) ---
# Prisma's datasource provider is "postgresql" and cannot switch to SQLite at runtime,
# so local development also needs a PostgreSQL instance.
# Fastest local option: `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/battend?schema=public"
# DIRECT_URL is required by some PostgreSQL providers (e.g. Supabase) for migrations.
# For local/dev it is usually the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/battend?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Session (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-secret-change-me-in-production-please-use-32+chars"

# --- Super Admin bootstrap (used by demo seed) ---
SUPER_ADMIN_EMAIL="super@b-attend.app"
SUPER_ADMIN_PASSWORD="demo1234"

# --- AI / B-Coach (mock provider is safe for demo; no key needed) ---
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AI_DAILY_COACH_ENABLED="true"
AI_EMPLOYEE_INSIGHTS_ENABLED="true"
AI_MANAGER_INSIGHTS_ENABLED="true"

# --- Activation & payments (manual mode for demo) ---
MANUAL_ACTIVATION_MODE="true"
PAYMENT_PROVIDER="manual"

# --- Email / SMTP (optional; leave blank to disable outbound email) ---
EMAIL_FROM="no-reply@b-attend.app"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
